# Copy to .env and fill in. .env is git-ignored.
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o

# Embedding models (defaults are fine for a portfolio build)
TEXT_EMBEDDING_MODEL=all-MiniLM-L6-v2
CLIP_MODEL=clip-ViT-B-32

# Storage / vector DB (paths are relative to the working dir)
CHROMA_PERSIST_DIR=./data/chroma
STORAGE_DIR=./data/storage

# Chunking & retrieval
CHUNK_SIZE=800
CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
MAX_TOP_K=20
